# Dumped by docs/examples/dump-examples.sh: canonicalization on its own.
# transpose(transpose(x)) folds to x while the op still means transpose, which is
# the whole argument for optimizing before lowering. Adapted from the upstream
# tutorial's reference/tests/Ch3/transpose_transpose.toy.
def transpose_transpose(x) {
  return transpose(transpose(x));
}

def main() {
  var a<2, 3> = [[1, 2, 3], [4, 5, 6]];
  var b = transpose_transpose(a);
  print(b);
}
