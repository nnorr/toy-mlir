# The three declarative (DRR) reshape rules from passes/ToyCombine.td, all
# firing at once: reshape(reshape(x)) collapses, a reshape of a constant folds
# into the constant, and a reshape that changes nothing disappears.
#
# RUN: %toyc %s -emit=mlir -opt 2>&1 | %filecheck %s

def main() {
  var a<2, 1> = [1, 2];
  var b<2, 1> = a;
  var c<2, 1> = b;
  print(c);
}

# CHECK: module {
# CHECK-NEXT:   toy.func @main() {
# CHECK-NEXT:     %0 = toy.constant dense<{{\[\[}}1.000000e+00], [2.000000e+00]]> : tensor<2x1xf64>
# CHECK-NEXT:     toy.print %0 : tensor<2x1xf64>
# CHECK-NEXT:     toy.return
# CHECK-NEXT:   }
# CHECK-NEXT: }
