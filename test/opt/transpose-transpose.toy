# transpose(transpose(x)) folds to x -- the hand-written C++ RewritePattern in
# passes/ToyCombine.cpp. Only expressible while the op still means "transpose":
# after lowering it is a loop nest over a memref and the pattern is gone.
#
# RUN: %toyc %s -emit=mlir -opt 2>&1 | %filecheck %s

def transpose_transpose(x) {
  return transpose(transpose(x));
}

def main() {
  var a<2, 3> = [[1, 2, 3], [4, 5, 6]];
  var b = transpose_transpose(a);
  print(b);
}

# CHECK: module {
# CHECK-NEXT:   toy.func @main() {
# CHECK-NEXT:     %0 = toy.constant dense<{{\[\[}}1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00]]> : tensor<2x3xf64>
# CHECK-NEXT:     toy.print %0 : tensor<2x3xf64>
# CHECK-NEXT:     toy.return
# CHECK-NEXT:   }
# CHECK-NEXT: }
