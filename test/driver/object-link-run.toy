# The end-to-end check that the lowering is real: compile to an object, link it
# with clang, run the resulting native executable, and require the same output
# the JIT produces.
#
# If these two ever disagree, the difference is in the environment the JIT
# provides rather than in the generated code -- which is exactly the failure
# this test exists to catch.
#
# REQUIRES: clang
# RUN: %toyc %s -c -o %t.o
# RUN: %clang %t.o -o %t.exe
# RUN: %t.exe | %filecheck %s
# RUN: %toyc %s -emit=jit 2>&1 | %filecheck %s

def main() {
  var a<2, 2> = [[1, 2], [3, 4]];
  print(transpose(a));
}

# CHECK: 1.000000 3.000000
# CHECK: 2.000000 4.000000
