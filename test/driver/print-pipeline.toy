# --print-pipeline prints the pass pipeline and compiles nothing.
#
# The pipeline is a value the driver builds (src/Pipeline.cpp), not something
# buried in main(), so it can be inspected without running it. The nesting is
# the part worth seeing: the Toy-level passes run under toy.func, the post-
# lowering cleanups under func.func, and only the inliner and the lowerings sit
# at module level.
#
# RUN: %toyc %s -emit=mlir -opt --print-pipeline | %filecheck %s --check-prefix=TOYOPT
# RUN: %toyc %s -emit=mlir-affine --print-pipeline | %filecheck %s --check-prefix=AFFINE
# RUN: %toyc %s -emit=mlir --print-pipeline | %filecheck %s --check-prefix=PLAIN

def main() {
  var a<2, 2> = [[1, 2], [3, 4]];
  print(transpose(a));
}

# The Toy stage with -opt: inline at module level, then the per-function passes.
# TOYOPT: builtin.module(
# TOYOPT-SAME: inline
# TOYOPT-SAME: toy.func(
# TOYOPT-SAME: canonicalize
# TOYOPT-SAME: cse

# Lowering to affine adds the Toy->affine pass plus cleanups under func.func.
# AFFINE: builtin.module(
# AFFINE-SAME: inline
# AFFINE-SAME: func.func(
# AFFINE-SAME: canonicalize

# Without -opt and without lowering there is nothing to run at all.
# PLAIN: builtin.module()
