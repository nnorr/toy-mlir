# Deviation D10: element-wise operands of different shapes fail verification.
#
# Upstream accepts the add, and the lowered loop runs over the lhs shape, reading
# past the end of the shorter rhs: -emit=jit prints `2 4 3` and exits 0.
#
# RUN: not %toyc %s -emit=jit 2>&1 | %filecheck %s

def main() {
  var a = [1, 2, 3];
  var b = [1, 2];
  print(a + b);
}

# CHECK: 'toy.add' op operand shapes must match, got 'tensor<3xf64>' and 'tensor<2xf64>'
