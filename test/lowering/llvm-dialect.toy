# Full conversion to the LLVM dialect: after this pass nothing but `llvm.*`
# remains, including toy.print, which becomes a loop nest around a printf call.
#
# The interesting line is the memref descriptor. A memref<2x2xf64> is not a
# pointer: it lowers to a five-field struct of allocated pointer, aligned
# pointer, offset, sizes and strides. Everything the memref type carried
# implicitly is spelled out here, and the allocation has become a malloc call
# with its own alignment arithmetic.
#
# RUN: %toyc %s -emit=mlir-llvm 2>&1 | %filecheck %s

def main() {
  var a<2, 2> = [[1, 2], [3, 4]];
  var b = transpose(a);
  print(b);
}

# The runtime pieces the print lowering inserts.
# CHECK-DAG: llvm.func @printf(!llvm.ptr, ...) -> i32
# CHECK-DAG: llvm.func @malloc(i64) -> !llvm.ptr
# CHECK-DAG: llvm.mlir.global internal constant @frmt_spec("%f \00")
# CHECK-DAG: llvm.mlir.global internal constant @nl("\0A\00")

# CHECK: llvm.func @main()
# CHECK: llvm.call @malloc
# CHECK: !llvm.struct<(ptr, ptr, i64, array<2 x i64>, array<2 x i64>)>
# CHECK: llvm.call @printf
