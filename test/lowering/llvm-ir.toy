# Out of MLIR entirely: translateModuleToLLVMIR turns the LLVM dialect into an
# llvm::Module, which is where MLIR's job ends and LLVM's begins.
#
# At -O0 the loops and the malloc are still there. With -opt LLVM's own -O3
# pipeline runs and the whole program collapses into straight-line printf calls:
# every value was a constant, so the loops, the buffer and the arithmetic all
# disappear. Worth putting next to the -O0 output on a slide.
#
# RUN: %toyc %s -emit=llvm 2>&1 | %filecheck %s --check-prefix=O0
# RUN: %toyc %s -emit=llvm -opt 2>&1 | %filecheck %s --check-prefix=O3
# RUN: %toyc %s -emit=llvm -opt 2>&1 | grep -c 'call i32 (ptr, ...) @printf' | %filecheck %s --check-prefix=NPRINTF
# RUN: %toyc %s -emit=llvm -opt 2>&1 | grep -c 'tail call i32 @putchar' | %filecheck %s --check-prefix=NPUTCHAR

def main() {
  var a<2, 2> = [[1, 2], [3, 4]];
  var b = transpose(a);
  print(b);
}

# O0: target triple =
# O0: @frmt_spec = internal constant [4 x i8] c"%f \00"
# O0: declare {{.*}}i32 @printf(ptr, ...)
# O0: define void @main()
# O0: call ptr @malloc
# The five-field memref descriptor, now in LLVM IR's own syntax.
# O0: { ptr, ptr, i64, [2 x i64], [2 x i64] }

# Nothing is left but the calls: no malloc, no loop, no arithmetic.
# O3: define void @main()
# O3-NOT: @malloc
# O3-NOT: br label
# O3: @printf

# One printf per element, plus one putchar per row for the newline.
# NPRINTF: 4
# NPUTCHAR: 2
